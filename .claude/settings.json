{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./vendor/**)",
      "Read(./node_modules/**)",
      "Read(./public/build/**)",
      "Read(./storage/**)",
      "Read(./composer.lock)",
      "Read(./package-lock.json)",
      "Read(./graphify-out/graph.json)"
    ],
    "allow": [
      "Bash(php artisan test:*)",
      "Bash(php artisan make:*)",
      "Bash(php artisan migrate:*)",
      "Bash(php artisan route:list:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(composer require:*)",
      "Bash(composer install:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
      "Bash($HOME/.local/bin/graphify:*)",
      "Bash(graphify:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  }
}